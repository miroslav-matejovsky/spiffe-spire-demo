FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /svid-client ./scenarios/05-svid-api/client

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 10002 appuser
COPY --from=builder /svid-client /usr/local/bin/svid-client
USER 10002
ENTRYPOINT ["svid-client"]
